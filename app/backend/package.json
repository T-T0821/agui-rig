{
  "name": "agui-rig-backend",
  "private": true,
  "type": "module",
  "description": "API Gateway (HTTP API + JWT オーソライザー) から呼ばれる Lambda: チャット履歴と利用料金",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/history.ts src/usage.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --out-extension:.js=.mjs --external:@aws-sdk/*",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1173.0",
    "@aws-sdk/client-secrets-manager": "^3.1173.0",
    "@aws-sdk/lib-dynamodb": "^3.1173.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
