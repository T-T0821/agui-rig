# 開発用の設定です (リリースビルドでは読みません)。配布するときの設定は README の「配布するとき」を見てください。

# ===== ログイン (OpenID Connect): 本番は Auth0、開発は Cognito も可 =====
# 未設定ならログインなしの開発モード (AWS は SDK 標準の認証: AWS_PROFILE / SSO など)
# README の「Auth0 の設定」を参照
OAUTH_ISSUER=https://your-tenant.auth0.com/
OAUTH_CLIENT_ID=your-client-id
# OAUTH_SCOPES=openid profile email offline_access
# リダイレクト URI のポート (http://127.0.0.1:<port>/callback)。Auth0 では固定が必須で、Allowed Callback URLs と同じにする
OAUTH_REDIRECT_PORT=53682
# 開発で Cognito を使うとき (README の「開発用のログイン (Cognito)」)。リダイレクト先は自動で http://localhost:<port>/callback になる
# OAUTH_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_XXXXXXXXX
# OAUTH_CLIENT_ID=<Cognito のアプリクライアント ID>
# リダイレクト URI のホスト (127.0.0.1 か localhost)。未設定なら Cognito は localhost、それ以外は 127.0.0.1
# OAUTH_REDIRECT_HOST=localhost

# ===== AWS =====
AWS_REGION=ap-northeast-1
# ID トークンで引き受ける IAM ロール (STS AssumeRoleWithWebIdentity)
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/chat-app-bedrock
# Bedrock のモデル (推論プロファイル ID)
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5-5
# AgentCore Code Interpreter (既定は AWS マネージド。off で無効)
# CODE_INTERPRETER_ID=aws.codeinterpreter.v1

# ===== チャット履歴 (API Gateway の URL。infra/terraform の出力 chat_api_url) =====
# CHAT_API_URL=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com

# ===== stdio MCP =====
# 未設定ならアプリの設定フォルダの mcp.json
# MCP_CONFIG=./mcp.json

# ===== トレース (OpenTelemetry → Langfuse) =====
# 未設定なら送信しない (ログは標準エラーだけ)
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# Collector など別の OTLP 受け口に送る場合 (Langfuse のキーより優先度は低い)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com
# Collector がログイン中の ID トークンで認証する場合 (本番のおすすめ。infra/otel-collector.yaml)
# TELEMETRY_AUTH=id_token
# プロンプト・回答・ツールの入出力・利用者 ID も記録する (既定は記録しない)
# TELEMETRY_RECORD_CONTENT=true
# ログの詳しさ
# RUST_LOG=info

# ===== 動作確認用: Bedrock の代わりに Anthropic API を使う =====
# LLM_MODEL=anthropic/claude-sonnet-5-5
# ANTHROPIC_API_KEY=
