# cp terraform.tfvars.example terraform.tfvars して値を入れる (terraform.tfvars はコミットしない)

region = "ap-northeast-1"

# ---- 本番: Auth0 ----
oidc_issuer    = "https://your-tenant.auth0.com/" # 末尾の / まで ID トークンの iss と一致させる
oidc_client_id = "your-client-id"

# ---- 開発: Auth0 の代わりに Cognito のユーザープールを作って使う ----
# (上の oidc_issuer / oidc_client_id は消す。本番とは別の state で apply する: terraform workspace new dev など)
# name           = "agui-rig-dev"
# table_name     = "agui-rig-dev-chat-history"
# create_cognito = true
# cognito_domain_prefix = "agui-rig-dev-xxxx"  # 空なら <name>-<アカウント ID>

# プロキシで呼べるモデルと単価 (100 万トークンあたりの USD)。載っていないモデルは呼べない。Bedrock の料金ページで確かめて入れる
# model_prices = {
#   "global.anthropic.claude-sonnet-5-5" = { input = 2, output = 10, cache_read = 0.1, cache_write = 2.5 }
#   "<別のモデルの推論プロファイル ID>"    = { input = <入力の単価>, output = <出力の単価> }
# }
# max_output_tokens = 16384

# プロキシのモデル呼び出し (トークン数・料金) を Langfuse に送る。アプリと同じ OTel Collector の受け口を指す
# proxy_otlp_traces_endpoint = "https://otel.example.com/v1/traces"
# proxy_trace_content        = false # プロンプトと回答の本文も送るか

# プロキシの Lambda が呼べるモデルを IAM でも絞る (おすすめ)
# bedrock_model_arns = [
#   "arn:aws:bedrock:ap-northeast-1:123456789012:inference-profile/global.anthropic.claude-sonnet-5-5",
#   "arn:aws:bedrock:*::foundation-model/anthropic.claude-sonnet-5-5*",
# ]

# 利用上限。1 人あたりの月の上限 USD、0 なら上限なし。
# 個別の上限・手動リセットは リポジトリのルートで LIMITS_TABLE=$(terraform -chdir=infra/terraform output -raw limits_table_name) pnpm limits ...
# default_monthly_limit_usd = 30
# limit_warn_ratio          = 0.8

# プロキシの同時実行数の上限 (全利用者の合計、-1 で設定しない)
# proxy_reserved_concurrency = 50
