{
  "name": "agui-rig",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:mock": "node app/desktop/dev/run.mjs mock",
    "dev:aws": "node app/desktop/dev/run.mjs aws",
    "dev:cloud": "node app/desktop/dev/run.mjs cloud",
    "dev-env": "node app/desktop/dev/cloud-env.mjs",
    "mock-server": "node app/desktop/dev/mock-server.mjs",
    "tauri": "pnpm --dir app/desktop exec tauri",
    "desktop:build": "pnpm --dir app/desktop run build",
    "backend:build": "pnpm --dir app/backend run build",
    "backend:test": "pnpm --dir app/backend run test",
    "backend:typecheck": "pnpm --dir app/backend run typecheck",
    "limits": "pnpm --dir app/backend run limits",
    "check": "pnpm backend:typecheck && pnpm backend:test && pnpm desktop:build"
  }
}
