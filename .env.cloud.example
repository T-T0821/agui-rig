# 自分の AWS 開発環境の設定。.env.cloud にコピーして使う (.env.cloud は git に入れない)。
#   cp .env.cloud.example .env.cloud
#   pnpm dev-env up      … 環境を作り、下に接続先 (OAUTH_ISSUER など) を書き足す
#   pnpm dev:cloud       … このファイルの値でアプリを起動する
#   pnpm dev-env down    … 環境を消し、書き足した接続先も消す
# シェルで設定した環境変数があれば、そちらが優先される。

# 名前 (英小文字・数字・ハイフン、20 文字まで)。リソース名は agui-rig-dev-<名前>、Terraform workspace は dev-<名前>
DEV_ENV_USER=alice
# ログインに使うメールアドレス (Cognito の利用者になる。仮パスワードが届く)
DEV_ENV_EMAIL=alice@example.com

# Terraform と aws CLI が使う AWS の認証 (aws sso login --profile ... 済みのプロファイルなど)
AWS_PROFILE=my-dev
AWS_REGION=ap-northeast-1

# チームの開発用アカウントの値 (管理者が infra/dev-account を apply した出力 env_cloud)。
# DEV_ENV_STATE_BUCKET があれば state を S3 に置き (無ければ各自の PC)、
# DEV_ENV_PERMISSIONS_BOUNDARY は開発者用の権限セットで作る IAM ロールに必須
# DEV_ENV_STATE_BUCKET=agui-rig-dev-tfstate-123456789012
# DEV_ENV_STATE_REGION=ap-northeast-1
# DEV_ENV_PERMISSIONS_BOUNDARY=arn:aws:iam::123456789012:policy/agui-rig-dev-boundary

# 使うモデルを変えるとき (任意)
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5-5
